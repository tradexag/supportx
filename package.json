{
  "name": "supportx",
  "version": "0.4.3",
  "description": "Self-hosted support inbox for marketplace sellers: Microsoft mail, weclapp order context, replaceable AI drafts and human review",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\" tests/policy.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:fakes": "tsx scripts/demo-fakes.ts",
    "demo": "tsx scripts/dev.ts --demo",
    "dev": "tsx scripts/dev.ts",
    "start:server": "tsx apps/server/main.ts",
    "start:worker": "tsx apps/worker/main.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "kernel:demo": "tsx examples/demo.ts",
    "recategorize": "tsx scripts/recategorize.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "8.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}

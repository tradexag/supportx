# SupportX – example configuration (no secrets). Copy to .env and fill in.
# Connector credentials (Microsoft, weclapp) are NOT configured here: owners enter them
# in the web UI (Einstellungen); they are stored encrypted in PostgreSQL.

# PostgreSQL connection
DATABASE_URL=postgres://supportx:CHANGE_ME@127.0.0.1:5432/supportx
# Only for docker compose (database container password; compose builds DATABASE_URL itself)
POSTGRES_PASSWORD=CHANGE_ME

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored connector credentials unreadable.
APP_ENCRYPTION_KEY=

# Web/API
# Public host name for deploy/docker-compose.prod.yml (Caddy, automatic HTTPS)
DOMAIN=
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# true behind HTTPS (required for production)
SECURE_COOKIES=false

# AI provider: "rules" (deterministic templates, no external call) or "claude"
AI_PROVIDER=rules
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=16000
# "default" = server-side refusal fallback beta, "off" to disable
CLAUDE_REFUSAL_FALLBACK=default

# Sending: drafts_only (default) or enabled. Even with "enabled", every connection needs
# send_enabled plus a verified reply route per platform before anything is sent.
SEND_MODE=drafts_only

# Worker
WORKER_POLL_MS=1000
MAIL_SYNC_INTERVAL_SEC=60
APPROVAL_TTL_MIN=240

# Development/demo only – never in production
DEMO_MODE=false
ALLOW_TEST_ENDPOINTS=false

# eBay Marketplace Account Deletion (needed for an eBay production keyset): 32–80 of A-Z a-z 0-9 _ -
# EBAY_DELETION_VERIFICATION_TOKEN=
